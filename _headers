# Cloudflare Pages / Netlify cache headers
# Long-lived caching for static, hash-able or rarely-changing assets.
# HTML stays short so content updates roll out quickly.

# HTML – short cache, must revalidate
/*
  Cache-Control: public, max-age=0, must-revalidate

# Fonts – immutable, cache 1 year
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Images – cache 30 days (bump version in URL or rename to invalidate)
/images/*
  Cache-Control: public, max-age=2592000

# CSS / JS – cache 7 days (rename file or add ?v= when shipping changes)
/*.css
  Cache-Control: public, max-age=604800
/*.js
  Cache-Control: public, max-age=604800

# Favicons / icons
/*.ico
  Cache-Control: public, max-age=2592000
/*.svg
  Cache-Control: public, max-age=2592000
/*.png
  Cache-Control: public, max-age=2592000
/*.jpg
  Cache-Control: public, max-age=2592000
/*.webp
  Cache-Control: public, max-age=2592000
/*.avif
  Cache-Control: public, max-age=2592000
